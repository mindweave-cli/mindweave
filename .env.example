# Copy this file to ".env" and fill in ONE key — whichever provider you want to use.
# The .env file is gitignored.
#
# You do not need more than one. Mindweave asks for a key the first time it needs
# one and writes it here for you, so this file is a reference rather than a chore.
# Set several and you can move between them with /provider and /model, in the same
# project, without restarting.
#
# A key can also live in ~/.mindweave/.env, which applies to every project. A key
# already exported in your shell wins over both.

# ── The provider you start with ──────────────────────────────────────────────
# DeepSeek is the default. Nothing else needs setting to get going.
DEEPSEEK_API_KEY=your-key-here

# ── Everything else Mindweave speaks ─────────────────────────────────────────
# ANTHROPIC_API_KEY=your-key-here     # Anthropic — Claude
# OPENAI_API_KEY=your-key-here        # OpenAI — GPT
# GEMINI_API_KEY=your-key-here        # Google — Gemini
# DASHSCOPE_API_KEY=your-key-here     # Alibaba — Qwen
# MOONSHOT_API_KEY=your-key-here      # Moonshot — Kimi
# ZAI_API_KEY=your-key-here           # Z.ai — GLM
# XAI_API_KEY=your-key-here           # xAI — Grok
# MISTRAL_API_KEY=your-key-here       # Mistral
# GROQ_API_KEY=your-key-here          # Groq
# CEREBRAS_API_KEY=your-key-here      # Cerebras
# MINIMAX_API_KEY=your-key-here       # MiniMax
# MODEL_API_KEY=your-key-here         # Meta — Muse Spark
# TOKENHUB_API_KEY=your-key-here      # Tencent — Hy, through TokenHub
# OPENROUTER_API_KEY=your-key-here    # OpenRouter, one key for many vendors

# ── Optional ─────────────────────────────────────────────────────────────────
# MINDWEAVE_MODEL — which model to open with. Otherwise the project's saved
#   choice, or DeepSeek V4 Flash on a fresh project. /model lists what each
#   provider offers, so there is no need to memorise ids.
# MINDWEAVE_MODEL=deepseek-v4-flash
#
# MINDWEAVE_BASE_URL — point the DeepSeek driver somewhere else (a proxy, a
#   compatible gateway). Every provider has its own equivalent override.
# MINDWEAVE_BASE_URL=https://api.deepseek.com

# MINDWEAVE_OPENROUTER_DATA — set to "deny" so OpenRouter only uses hosts that do
#   not store or train on prompts. Unset, OpenRouter's own default applies (allow).
# MINDWEAVE_OPENROUTER_DATA=deny

# Ollama (models on this machine) needs no key: it counts as set up while it runs.
# OLLAMA_HOST — where the Ollama server is, as Ollama itself reads it.
# OLLAMA_HOST=127.0.0.1:11434
# MINDWEAVE_OLLAMA_CONTEXT — the context window asked of Ollama, in tokens (default 32768).
#   Smaller uses less memory on a small machine; the agent then compacts sooner.
# MINDWEAVE_OLLAMA_CONTEXT=16384

# LM Studio (models on this machine) needs no key either: it counts as set up while it runs.
# MINDWEAVE_LMSTUDIO_URL — only when the server is not on this computer (default http://127.0.0.1:1234).
# MINDWEAVE_LMSTUDIO_URL=http://192.168.1.20:1234
# llama.cpp (llama-server) likewise. MINDWEAVE_LLAMACPP_URL names a server that is elsewhere or on another port.
# MINDWEAVE_LLAMACPP_URL=http://127.0.0.1:8080

# Custom endpoint — any server that speaks the OpenAI chat wire (a host, a gateway, your own vLLM).
# MINDWEAVE_CUSTOM_URL=https://api.together.xyz/v1
# MINDWEAVE_CUSTOM_API_KEY=your-key-here           # only if the server wants one
# MINDWEAVE_CUSTOM_MODELS=model-a,model-b          # only if the server has no model list
# MINDWEAVE_CUSTOM_WINDOW=128000                   # what its models hold, when it does not say

# A coding plan has its own address, and its key works only there. Every provider has one of these:
# MINDWEAVE_GLM_URL=https://api.z.ai/api/coding/paas/v4
# MINDWEAVE_QWEN_URL=https://coding-intl.dashscope.aliyuncs.com/v1
# MINDWEAVE_KIMI_URL=https://api.kimi.com/coding/v1
